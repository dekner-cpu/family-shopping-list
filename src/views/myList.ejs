<%- include('partials/header', { title: 'הרשימה שלי', activeTab: 'my-list', currentUser: currentUser }) %>
<div class="page-head">
  <h1>הרשימה שלי</h1>
  <p>הוסיפו פריטים לרשימה. <%= currentUser.role === 'parent' ? 'ההורים יכולים לאשר גם לעצמם.' : 'הורה יאשר או ידחה כל פריט בנפרד.' %></p>
</div>

<% if (cycleLocked) { %>
  <div class="banner locked">הרשימה הראשית נעולה כרגע — פריטים חדשים שיאושרו ימתינו לשחרור הנעילה.</div>
<% } %>

<div class="ticket">
  <h3>הוספת פריט</h3>
  <form id="add-item-form">
    <div class="field">
      <label for="add-product-name">שם המוצר</label>
      <input type="text" id="add-product-name" name="productName" required>
    </div>
    <div class="field">
      <label for="add-quantity">כמות (אופציונלי)</label>
      <input type="text" id="add-quantity" name="quantity" placeholder="למשל: 2 יח׳">
    </div>
    <div class="field">
      <label for="add-notes">הערות (אופציונלי)</label>
      <textarea id="add-notes" name="notes"></textarea>
    </div>
    <div id="add-item-error" class="helper-text" style="color: var(--danger-ink); display: none;"></div>
    <button type="submit" class="btn btn-primary btn-block">הוסף לרשימה</button>
  </form>
</div>

<h2 style="margin-top: 24px;">הפריטים שלי</h2>

<% if (items.length === 0) { %>
  <div class="empty-state">עדיין לא הוספת פריטים במחזור הנוכחי.</div>
<% } %>

<% items.forEach(function(item) { %>
  <div class="ticket status-<%= item.status %>" data-item-id="<%= item.id %>">
    <div class="ticket-row">
      <div class="ticket-main">
        <% if (item.status === 'approved') { %>
          <div class="ticket-product"><%= item.product_name %></div>
          <% if (item.quantity) { %><div class="ticket-meta">כמות: <%= item.quantity %></div><% } %>
          <% if (item.notes) { %><div class="ticket-meta"><%= item.notes %></div><% } %>
        <% } else { %>
          <form class="edit-item-form">
            <div class="field">
              <label>שם המוצר</label>
              <input type="text" name="productName" value="<%= item.product_name %>" required>
            </div>
            <div class="field">
              <label>כמות</label>
              <input type="text" name="quantity" value="<%= item.quantity || '' %>">
            </div>
            <div class="field">
              <label>הערות</label>
              <textarea name="notes"><%= item.notes || '' %></textarea>
            </div>
            <div class="item-error helper-text" style="color: var(--danger-ink); display: none;"></div>
            <div class="btn-row">
              <button type="submit" class="btn btn-primary">שמור<%= item.status === 'rejected' ? ' והגש מחדש' : '' %></button>
              <button type="button" class="btn btn-secondary delete-item-btn">מחק</button>
            </div>
          </form>
        <% } %>
      </div>
      <span class="stamp <%= item.status %>">
        <%= item.status === 'pending' ? 'ממתין' : item.status === 'approved' ? 'אושר' : 'נדחה' %>
      </span>
    </div>
  </div>
<% }); %>

<script src="/js/myList.js"></script>
<%- include('partials/footer') %>
