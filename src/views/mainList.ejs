<%- include('partials/header', { title: 'רשימה ראשית', activeTab: 'main-list', currentUser: currentUser }) %>
<div class="page-head">
  <h1>הרשימה הראשית</h1>
  <p>כל הפריטים שאושרו על ידי הורה, ממוזגים לרשימה משותפת אחת.</p>
</div>

<% if (cycle.status === 'locked') { %>
  <div id="cycle-banner" class="banner locked">
    הרשימה נעולה — אפשר לצאת לקניות.
    <% if (currentUser.role === 'parent') { %>
      אפשר גם <a href="/purchase-report">לדווח מה נקנה</a> בסיום.
    <% } %>
  </div>
<% } else { %>
  <div id="cycle-banner" class="banner info">הרשימה פתוחה לעדכונים — פריטים חדשים שיאושרו יתווספו אליה.</div>
<% } %>

<div id="lock-error" class="helper-text" style="color: var(--danger-ink); display: none;"></div>

<% if (currentUser.role === 'parent') { %>
  <div class="ticket" style="margin-bottom: 18px;">
    <h3>שליחת הודעת מערכת</h3>
    <form id="system-message-form">
      <div class="field">
        <label for="system-message-text">הודעה לכל המשתמשים</label>
        <textarea id="system-message-text" name="text" placeholder="למשל: יוצאים לקניות היום ב-18:00" required></textarea>
      </div>
      <div id="system-message-error" class="helper-text" style="color: var(--danger-ink); display: none;"></div>
      <div id="system-message-success" class="helper-text" style="color: var(--primary-ink); display: none;">ההודעה נשלחה!</div>
      <button type="submit" class="btn btn-secondary">שלח הודעת מערכת</button>
    </form>
  </div>

  <div id="lock-controls" class="btn-row" style="margin-bottom: 18px;">
    <% if (cycle.status === 'open') { %>
      <button id="lock-btn" class="btn btn-primary">נעל וסדר רשימה</button>
    <% } else if (cycle.status === 'locked') { %>
      <button id="unlock-btn" class="btn btn-secondary">שחרר נעילה (לאישור פריטים נוספים)</button>
    <% } %>
  </div>

  <% if (items.length > 0) { %>
    <div class="btn-row" style="margin-bottom: 18px;">
      <button id="edit-list-btn" class="btn btn-secondary" type="button" data-cycle-status="<%= cycle.status %>">ערוך רשימה</button>
    </div>
  <% } %>
<% } %>

<div id="edit-list-error" class="helper-text" style="color: var(--danger-ink); display: none;"></div>

<% if (items.length === 0) { %>
  <div class="empty-state">עדיין אין פריטים ברשימה הראשית במחזור הנוכחי.</div>
<% } else { %>
  <table id="main-list-table" class="list-table">
    <thead>
      <tr><th>מוצר</th><th>כמות</th><th>הערות</th><th>קטגוריה</th></tr>
    </thead>
    <tbody>
      <% items.forEach(function(item) { %>
        <tr data-item-id="<%= item.id %>" data-product-name="<%= item.product_name %>" data-quantity="<%= item.quantity || '' %>" data-notes="<%= item.notes || '' %>" data-category="<%= item.category || 'other' %>">
          <td><%= item.product_name %></td>
          <td><%= item.quantity || '—' %></td>
          <td><%= item.notes || '—' %></td>
          <td><%= categoryLabel(item.category) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <% if (currentUser.role === 'parent') { %>
    <div id="edit-list-actions" class="btn-row" style="display: none; margin-top: 12px;">
      <button id="save-list-btn" class="btn btn-primary" type="button">שמור שינויים</button>
      <button id="cancel-edit-btn" class="btn btn-secondary" type="button">ביטול</button>
    </div>
  <% } %>
<% } %>

<script>
  const MAIN_LIST_CATEGORIES = <%- JSON.stringify(categories.map(function (c) { return { key: c.key, label: c.label }; })) %>;

  async function callLockApi(path) {
    const errorBox = document.getElementById('lock-error');
    errorBox.style.display = 'none';
    try {
      const res = await fetch(path, { method: 'POST' });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'משהו השתבש, נסו שוב');
      window.location.reload();
    } catch (err) {
      errorBox.textContent = err.message;
      errorBox.style.display = 'block';
    }
  }
  const lockBtn = document.getElementById('lock-btn');
  if (lockBtn) lockBtn.addEventListener('click', () => callLockApi('/api/main-list/lock'));
  const unlockBtn = document.getElementById('unlock-btn');
  if (unlockBtn) unlockBtn.addEventListener('click', () => callLockApi('/api/main-list/unlock'));

  const editListBtn = document.getElementById('edit-list-btn');
  const editListActions = document.getElementById('edit-list-actions');
  const mainListTable = document.getElementById('main-list-table');
  const editListError = document.getElementById('edit-list-error');

  function markCycleUnlockedInUi() {
    const banner = document.getElementById('cycle-banner');
    if (banner) {
      banner.className = 'banner info';
      banner.textContent = 'הרשימה פתוחה לעדכונים — פריטים חדשים שיאושרו יתווספו אליה.';
    }
    const lockControls = document.getElementById('lock-controls');
    if (lockControls) lockControls.style.display = 'none';
  }

  function makeEditableCell(className, value) {
    const td = document.createElement('td');
    const input = document.createElement('input');
    input.type = 'text';
    input.className = className;
    input.value = value;
    td.appendChild(input);
    return td;
  }

  function makeCategoryCell(currentCategory) {
    const td = document.createElement('td');
    const select = document.createElement('select');
    select.className = 'edit-category';
    MAIN_LIST_CATEGORIES.forEach((category) => {
      const option = document.createElement('option');
      option.value = category.key;
      option.textContent = category.label;
      if (category.key === currentCategory) option.selected = true;
      select.appendChild(option);
    });
    td.appendChild(select);
    return td;
  }

  function enterEditMode() {
    if (!mainListTable) return;
    mainListTable.querySelectorAll('tbody tr').forEach((tr) => {
      const productName = tr.dataset.productName || '';
      const quantity = tr.dataset.quantity || '';
      const notes = tr.dataset.notes || '';
      const category = tr.dataset.category || 'other';
      tr.textContent = '';
      tr.appendChild(makeEditableCell('edit-product-name', productName));
      tr.appendChild(makeEditableCell('edit-quantity', quantity));
      tr.appendChild(makeEditableCell('edit-notes', notes));
      tr.appendChild(makeCategoryCell(category));
    });
    if (editListBtn) editListBtn.style.display = 'none';
    if (editListActions) editListActions.style.display = 'flex';
  }

  if (editListBtn) {
    editListBtn.addEventListener('click', async () => {
      if (editListError) editListError.style.display = 'none';
      editListBtn.disabled = true;
      try {
        if (editListBtn.dataset.cycleStatus === 'locked') {
          const res = await fetch('/api/main-list/unlock', { method: 'POST' });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'משהו השתבש, נסו שוב');
          markCycleUnlockedInUi();
        }
        enterEditMode();
      } catch (err) {
        if (editListError) {
          editListError.textContent = err.message;
          editListError.style.display = 'block';
        }
      } finally {
        editListBtn.disabled = false;
      }
    });
  }

  const cancelEditBtn = document.getElementById('cancel-edit-btn');
  if (cancelEditBtn) cancelEditBtn.addEventListener('click', () => window.location.reload());

  const saveListBtn = document.getElementById('save-list-btn');
  if (saveListBtn) {
    saveListBtn.addEventListener('click', async () => {
      if (editListError) editListError.style.display = 'none';
      const items = Array.from(mainListTable.querySelectorAll('tbody tr')).map((tr) => ({
        id: Number(tr.dataset.itemId),
        productName: tr.querySelector('.edit-product-name').value.trim(),
        quantity: tr.querySelector('.edit-quantity').value.trim(),
        notes: tr.querySelector('.edit-notes').value.trim(),
        category: tr.querySelector('.edit-category').value,
      }));

      saveListBtn.disabled = true;
      try {
        const res = await fetch('/api/main-list/items', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'משהו השתבש, נסו שוב');
        window.location.reload();
      } catch (err) {
        if (editListError) {
          editListError.textContent = err.message;
          editListError.style.display = 'block';
        }
        saveListBtn.disabled = false;
      }
    });
  }

  const systemMessageForm = document.getElementById('system-message-form');
  if (systemMessageForm) {
    systemMessageForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorBox = document.getElementById('system-message-error');
      const successBox = document.getElementById('system-message-success');
      errorBox.style.display = 'none';
      successBox.style.display = 'none';
      const textarea = document.getElementById('system-message-text');
      const text = textarea.value.trim();
      if (!text) return;
      try {
        const res = await fetch('/api/system-message/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'משהו השתבש, נסו שוב');
        textarea.value = '';
        successBox.style.display = 'block';
      } catch (err) {
        errorBox.textContent = err.message;
        errorBox.style.display = 'block';
      }
    });
  }
</script>
<%- include('partials/footer') %>
